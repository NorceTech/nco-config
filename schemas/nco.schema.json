{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/norce/nco-config/main/schemas/nco.schema.json",
  "title": "nco.yaml",
  "description": "Norce Checkout configuration-as-code project file.",
  "type": "object",
  "required": ["merchant", "environments", "layers"],
  "additionalProperties": false,
  "properties": {
    "merchant": { "type": "string", "description": "Merchant identifier used in the configuration API." },
    "slug": { "type": "string", "description": "Public API host prefix (https://<slug>.api-se.norce.tech). Defaults to merchant." },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["target"],
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "description": "Deployed environment this maps to: prod, stage, playground (or a single-tenant target from the catalog)." },
          "channelSuffix": { "type": "string", "description": "Appended to every channel name in this environment, e.g. \"-qa\"." },
          "channelPrefix": { "type": "string" },
          "vars": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Values for ${var:name} in this environment." },
          "apiBaseUrl": { "type": "string", "format": "uri", "description": "Override the configuration API base URL." },
          "token": { "type": "string", "description": "Bearer token, normally \"${secret:NCO_TOKEN_<ENV>}\" (the default)." }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "Dimension name → values. Channels are the cartesian product.",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "channelName": { "type": "string", "description": "Channel name template, e.g. \"${brand}-${market}${segment}\"." },
    "channelNameParts": {
      "type": "object",
      "description": "Dimension → value → name fragment, e.g. segment: { b2c: \"\", b2b: \"-b2b\" }.",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "channels": {
      "type": "object",
      "description": "Channels outside the matrix: name → dimension values (may be empty).",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "exclude": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "description": "Matrix combinations to drop." },
    "features": {
      "type": "object",
      "description": "Feature → which channels get it: true, a selector or a list of selectors.",
      "additionalProperties": { "oneOf": [{ "const": true }, { "$ref": "#/$defs/selector" }, { "type": "array", "items": { "$ref": "#/$defs/selector" } }] }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Layer directories in merge order. Placeholders: ${<dimension>}, ${env}, ${target}, ${channel}, ${feature}."
    },
    "vars": { "type": "object", "additionalProperties": { "type": "string" } },
    "lookups": { "type": "string", "description": "Lookup tables file (default lookups.yaml)." },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": { "type": "array", "items": { "enum": ["env", "dotenv"] } },
        "dotenv": { "type": "string", "description": "dotenv file template, default \".env.${env}\"." }
      }
    },
    "managedConfigurations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "catalog": { "type": "string", "description": "Path to an adapter catalog overriding the one shipped with the tool." },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "channelName": { "type": "string", "description": "Regex every deployed channel name must match." } }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "description": "Dimension (or `channel`) → value or list of values; all listed must match.",
      "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
    }
  }
}
